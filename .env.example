# ブラウザーで使うため、HTTPリファラーとAPIで必ず制限してください。
# Maps JavaScript API / Places API (New) / Routes API を有効にします。
GOOGLE_MAPS_BROWSER_API_KEY=your_restricted_browser_key

# サーバーだけで利用します。ブラウザー用キーとは分けてください。
GEMINI_API_KEY=your_server_side_gemini_key
GEMINI_MODEL=gemini-2.5-flash

# 公開URL。Gemini APIへのブラウザー送信元チェックに使用します。
APP_ORIGIN=https://example.com

# 信頼できるリバースプロキシ配下でのみ1にします。
TRUST_PROXY=0

PORT=3000
